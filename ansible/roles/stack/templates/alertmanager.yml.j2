# Plik generowany przez Ansible - nie edytuj ręcznie.
route:
  receiver: {{ 'telegram' if telegram_enabled | bool else '"null"' }}
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: "null"
{% if telegram_enabled | bool %}
  - name: telegram
    telegram_configs:
      - bot_token: "{{ telegram_bot_token }}"
        chat_id: {{ telegram_chat_id | int }}
        parse_mode: HTML
        send_resolved: true
{% endif %}
