# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# Obraz aplikacji w GitHub Container Registry: ghcr.io/<login-github-małymi-literami>/devops-projekt
IMAGE=ghcr.io/CHANGE_ME/devops-projekt

# Hasło administratora Grafany (min. 8 znaków)
GRAFANA_ADMIN_PASSWORD=

# Bot Telegram: token od @BotFather, chat_id z "make telegram-chat-id"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail na alert budżetowy AWS (powiadomienie, gdy koszt przekroczy 1 USD)
BUDGET_EMAIL=

# Opcjonalnie HTTPS: wpisz domenę z "make output" (tls_domain), np. 3-120-45-67.sslip.io
# Puste = zwykły HTTP na porcie 80
SITE_ADDRESS=
