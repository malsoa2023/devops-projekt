{
	admin off
}

# SITE_ADDRESS=":80" -> zwykły HTTP
# SITE_ADDRESS="1-2-3-4.sslip.io" -> HTTPS z automatycznym certyfikatem Let's Encrypt
{$SITE_ADDRESS::80} {
	encode gzip

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# Load balancer: rozkłada ruch po wszystkich replikach usługi "app" (round robin).
	# Lista replik odświeżana z DNS Dockera, więc skalowanie nie wymaga zmian w konfiguracji.
	handle {
		reverse_proxy {
			dynamic a {
				name app
				port 8000
				refresh 5s
			}
			lb_policy round_robin
			lb_try_duration 5s
			fail_duration 30s
		}
	}

	log {
		output stdout
		format json
	}
}
